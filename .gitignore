.cache/
.DS_Store
# Go writes build output to `bin/`, but this repository also keeps its one
# operational entry point there. `bin/*` rather than `bin/` is load-bearing:
# git cannot re-include anything under an excluded *directory*, so the ignore
# rule has to name the contents. CHG-20260926-067 T-04.
bin/*
!bin/*.sh
dist/
web/dist/
web/dist-cloud/
web/dist-desktop/
web/node_modules/
*.log
logs/
*.pid
/server
.env.local
.pytest_cache/
# The object-storage key pair is supplied by whoever runs the acceptance and is
# never committed. The `.example` templates beside these paths are committed and
# carry no values; see `config/README.md` for why this credential differs from
# the tracked `credentials/agent.toml` and `credentials/douyin.toml`.
config/credentials/object_storage.toml
config_online/credentials/object_storage.toml
