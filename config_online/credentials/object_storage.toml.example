# Template for `config_online/credentials/object_storage.toml`, which is NOT tracked.
#
# This tree is the release-time drop-in replacement for `config`, so at deploy
# time the real file has to be present in the packaged `config` directory. It is
# injected by the deployment, the same way `database/primary.toml`'s password and
# `credentials/agent.toml`'s token are — the difference is only that this one is
# also excluded from Git, so an injected file cannot be committed by accident.
#
# Leave it absent and Cloud still starts; every object-storage call answers
# `ErrNotConfigured` until the pair is supplied.

access_key = ''
secret_key = ''
