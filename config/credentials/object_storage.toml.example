# Template for `config/credentials/object_storage.toml`, which is NOT tracked.
#
# Copy it to `object_storage.toml` (next to this file) and fill in the key pair.
# The real file is in `.gitignore`; this template has no values and is safe to
# commit. See `config/README.md` for why this one credential differs from
# `douyin.toml` and `agent.toml`, which are tracked.
#
# The file is optional at load time: leave it absent and Cloud starts normally,
# answering `ErrNotConfigured` on every object-storage call. Configure only ONE
# of the two values and startup fails, because a half-written file is a mistake
# rather than a state.

access_key = ''
secret_key = ''
