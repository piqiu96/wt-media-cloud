# Paste inside the existing BaoTa HTTPS server block for wt.longyanyue.cn.
# Replace an existing root, index, and location / block rather than duplicating
# them. BaoTa continues to manage the listen, server_name, and TLS settings.
root /www/wt-media-cloud/current/web;
index index.cloud.html;

location ^~ /api/ {
    # No trailing URI in proxy_pass: keep /api/v1/... unchanged for Cloud.
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location = /healthz {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location / {
    # Vue uses history routing, so /login and deep links need the entry page.
    try_files $uri $uri/ /index.cloud.html;
}
