# Template for the private `shared/config/credentials/object_storage.toml`.
#
# Copy it to the same directory without `.example` and fill it on the server.
# Do not add the filled-in file to the release package.
#
# Leave it absent and Cloud still starts; every object-storage call answers
# `ErrNotConfigured` until the pair is supplied.

access_key = ''
secret_key = ''
