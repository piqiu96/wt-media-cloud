[Unit]
Description=WT Media Cloud Discovery Worker
After=network.target wt-media-cloud-server.service
Requires=wt-media-cloud-server.service

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wt-media-cloud/current
Environment=TMPDIR=/www/wt-media-cloud/shared/data/tmp
ExecStart=/www/wt-media-cloud/current/bin/discovery-worker
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
